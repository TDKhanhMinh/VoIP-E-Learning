NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PREFIX=api
API_VERSION=1

CORS_ORIGINS=http://localhost:5173,http://localhost:5174
BODY_LIMIT=2mb
TRUST_PROXY=false
LOG_LEVEL=info
LOG_FILE_ENABLED=false
LOG_FILE_PATH=logs/backend-remake.log
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
SWAGGER_ENABLED=false
V1_COMPATIBILITY_ADAPTER_ENABLED=false

# Persistence is optional until the first domain module is migrated.
MONGO_ENABLED=false
MONGO_URI=
MONGO_AUTO_INDEX=false

# Local-only credentials for the compose MongoDB service. Replace them outside local development.
JWT_ACCESS_SECRET=development-access-secret-change-before-production-12345
JWT_REFRESH_SECRET=development-refresh-secret-change-before-production-12345
JWT_ISSUER=voip-elearning-api
JWT_AUDIENCE=voip-elearning-client
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# Phase 00 composition lock: every provider remains OFF until its later-phase
# adapter, authorization, tests and operational approval are present.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_DRIVE_ENABLED=false
CLOUDINARY_ENABLED=false
LIVEKIT_ENABLED=false
SMTP_ENABLED=false
RECORDING_ENABLED=false
AWS_RECORDING_ENABLED=false
GEMINI_ENABLED=false
SIP_ENABLED=false
