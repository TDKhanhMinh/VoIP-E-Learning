NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PREFIX=api
API_VERSION=1

CORS_ORIGINS=http://localhost:5173,http://localhost:5174
BODY_LIMIT=2mb
TRUST_PROXY=false
LOG_LEVEL=info
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

# Persistence is optional until the first domain module is migrated.
MONGO_ENABLED=false
MONGO_URI=
MONGO_AUTO_INDEX=false

# Optional integrations remain disabled until their adapters are implemented.
SIP_ENABLED=false
AWS_RECORDING_ENABLED=false
