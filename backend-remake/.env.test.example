NODE_ENV=test
HOST=127.0.0.1
PORT=0
API_PREFIX=api
API_VERSION=1

CORS_ORIGINS=http://localhost:5173
BODY_LIMIT=2mb
TRUST_PROXY=false
LOG_LEVEL=silent
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=10000
SWAGGER_ENABLED=false
V1_COMPATIBILITY_ADAPTER_ENABLED=false

# This name is checked by the test harness before it clears data.
MONGO_ENABLED=true
MONGO_URI=mongodb://root:local-password@localhost:27017/voip_elearning_test?authSource=admin&replicaSet=rs0
MONGO_AUTO_INDEX=true

JWT_ACCESS_SECRET=test-access-secret-that-is-never-used-outside-tests-12345
JWT_REFRESH_SECRET=test-refresh-secret-that-is-never-used-outside-tests-12345
JWT_ISSUER=voip-elearning-api-test
JWT_AUDIENCE=voip-elearning-client-test
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

GOOGLE_OAUTH_ENABLED=false
GOOGLE_DRIVE_ENABLED=false
CLOUDINARY_ENABLED=false
LIVEKIT_ENABLED=false
SMTP_ENABLED=false
RECORDING_ENABLED=false
AWS_RECORDING_ENABLED=false
GEMINI_ENABLED=false
SIP_ENABLED=false
